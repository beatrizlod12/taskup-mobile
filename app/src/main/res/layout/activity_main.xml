<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBF6EF"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mousseomanos"
        android:textColor="#2B1E1A"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Controle de estoque para vendedores ambulantes"
        android:textColor="#6B5B52"
        android:textSize="14sp" />

    <!-- Formulário: cadastra e edita -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F2E7DA"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/txtTituloForm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Novo produto"
            android:textColor="#A3510F"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nome"
            android:inputType="textCapSentences"
            android:textColor="#2B1E1A"
            android:textColorHint="#8A7A70" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edtPreco"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Preço"
                android:inputType="numberDecimal"
                android:textColor="#2B1E1A"
                android:textColorHint="#8A7A70" />

            <EditText
                android:id="@+id/edtQuantidade"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Quantidade"
                android:inputType="number"
                android:textColor="#2B1E1A"
                android:textColorHint="#8A7A70" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSalvar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#A3510F"
                android:text="Cadastrar" />

            <Button
                android:id="@+id/btnCancelar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:backgroundTint="#6B5B52"
                android:text="Cancelar"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Botões que abrem as outras telas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnVendas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#3E2723"
            android:text="🛒 Nova venda" />

        <Button
            android:id="@+id/btnWebView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#A3510F"
            android:text="⭐ Pesquisa" />
    </LinearLayout>

    <!-- Pesquisa e filtro -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/edtBusca"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Pesquisar por nome"
            android:inputType="text"
            android:textColor="#2B1E1A"
            android:textColorHint="#8A7A70" />

        <Button
            android:id="@+id/btnBuscar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#2B1E1A"
            android:text="Buscar" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/chkBaixo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Só estoque baixo (até 5)"
        android:textColor="#2B1E1A" />

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp"
        android:text="Carregando..."
        android:textColor="#6B5B52" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>